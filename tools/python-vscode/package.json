{
  "name": "python-ifc-lsp",
  "displayName": "Python Information Flow Control Language Server",
  "description": "Language server for detecting information flows and leakage in Python",
  "version": "0.1.0",
  "publisher": "monarch",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "monarch.showInfluencedLines",
        "title": "Explain taint flow",
        "category": "Monarch"
      },
      {
        "command": "monarch.resetDecorations",
        "title": "Remove taint explanations",
        "category": "Monarch"
      },
      {
        "command": "monarch.toggleTaintGranularity",
        "title": "Toggle Taint Granularity (Column ↔ Object)",
        "category": "Monarch"
      },
      {
        "command": "monarch.useColumnTaint",
        "title": "Use Column-Level Taint Tracking",
        "category": "Monarch",
        "icon": "$(symbol-field)"
      },
      {
        "command": "monarch.useObjectTaint",
        "title": "Use Object-Level Taint Tracking",
        "category": "Monarch",
        "icon": "$(table)"
      },
      {
        "command": "monarch.taintGranularity.columnActive",
        "title": "Taint tracking: column-level (click to switch to object-level)",
        "category": "Monarch",
        "icon": "$(symbol-field)"
      },
      {
        "command": "monarch.taintGranularity.objectActive",
        "title": "Taint tracking: object-level (click to switch to column-level)",
        "category": "Monarch",
        "icon": "$(table)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Python IFC Language Server",
      "properties": {
        "pythonIfcLsp.serverPath": {
          "type": "string",
          "default": "python-ifc-lsp",
          "description": "Path to the python-ifc-lsp executable. Defaults to 'python-ifc-lsp' which will look for the executable in PATH."
        },
        "pythonIfcLsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        },
        "pythonIfcLsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the Python IFC Language Server"
        },
        "pythonIfcLsp.taintGranularity": {
          "type": "string",
          "enum": [
            "column",
            "object"
          ],
          "enumDescriptions": [
            "Only the sensitive columns of a DataFrame are tainted",
            "A DataFrame with a sensitive column is tainted as a whole"
          ],
          "default": "column",
          "description": "Whether sources taint only the sensitive columns of a DataFrame, or the DataFrame as a whole."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "monarch.taintGranularity.columnActive",
          "when": "editorLangId == python && config.pythonIfcLsp.taintGranularity != 'object'",
          "group": "navigation@-100"
        },
        {
          "command": "monarch.taintGranularity.objectActive",
          "when": "editorLangId == python && config.pythonIfcLsp.taintGranularity == 'object'",
          "group": "navigation@-100"
        }
      ],
      "commandPalette": [
        {
          "command": "monarch.taintGranularity.columnActive",
          "when": "false"
        },
        {
          "command": "monarch.taintGranularity.objectActive",
          "when": "false"
        },
        {
          "command": "monarch.useColumnTaint",
          "when": "config.pythonIfcLsp.taintGranularity == 'object'"
        },
        {
          "command": "monarch.useObjectTaint",
          "when": "config.pythonIfcLsp.taintGranularity != 'object'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "monarch.toggleTaintGranularity",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorLangId == python"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0",
    "watch": "^0.13.0"
  }
}
